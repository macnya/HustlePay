# ---------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the M-PESA callback route (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Safaricom M-PESA Daraja — https://developer.safaricom.co.ke
# Leave MPESA_ENV=sandbox while testing with the Safaricom test shortcode.
# ---------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Public HTTPS callback URL for Daraja.
# Defaults to https://$VERCEL_URL/api/mpesa/callback on Vercel;
# set it explicitly for custom domains.
MPESA_CALLBACK_URL=